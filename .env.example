# ---- required: get these from https://my.telegram.org/apps ----
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# ---- the bot that carries the buttons ----
# Inline buttons are a bot-only feature of the Telegram API: a user account
# cannot attach them and cannot receive button presses. So the card is posted
# by a companion bot. Create one with @BotFather, paste its token here, and
# add the bot to every chat where you want offers with buttons.
#
# Leave empty and everything still works, minus the buttons: the account
# posts the card itself.
BOT_TOKEN=

# ---- session ----
# Leave TG_SESSION empty on first run: the bot signs in interactively and
# stores offerbot.session next to the code.
# For a server, run `python -m offerbot login` once and paste the string here.
#
# WARNING: a session string is full access to the account — no password, no 2FA
# prompt. Treat it exactly like a password. Never commit it, never paste it in
# a chat, never share a screenshot of it.
TG_SESSION=
TG_SESSION_NAME=offerbot

# ---- offer card defaults ----
DEFAULT_LANG=en            # en | ru — used when the command omits the language
DEFAULT_CURRENCY=          # stars | gram — leave empty to always require it
DEFAULT_TTL=6h             # offer lifetime when the command omits it (5m..7d)
CONTACT=@your_username     # shown as the "From" line; empty uses your account
SHOW_ESCROW=true           # show the "escrow / hold" line

# ---- preview ----
INVERT_MEDIA=true          # put the gift picture ABOVE the text
LARGE_MEDIA=true           # ask Telegram for the large image
RESEND_FALLBACK=true       # if the command can no longer be edited, post anew

# ---- storage and timing ----
DB_PATH=offers.db          # open offers live here so a restart does not lose them
SWEEP_INTERVAL=30          # seconds between expiry checks
ERROR_TTL=12               # seconds a parse-error notice stays in the chat
RATE_TTL=300               # seconds to cache the TON price
STAR_USD_RATE=0.015        # Telegram publishes no Stars rate; this is manual
FLOOD_SLEEP_THRESHOLD=60   # auto-wait out floods shorter than this
GIFT_ALIASES_FILE=         # optional JSON {"spelling": "CanonicalSlug"}
